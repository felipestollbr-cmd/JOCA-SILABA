# =================================
# Sílaba Aventura com o Joca - Config
# =================================

# Porta do servidor
PORT=3001

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Chave de API opcional (para proteger endpoints)
CLIENT_API_KEY=sua_chave_super_secreta_aqui

# Google Cloud TTS (opcional, para síntese de voz)
GOOGLE_TTS_KEY=sua_chave_google_aqui

# Variáveis de ambiente custom
NODE_ENV=development
